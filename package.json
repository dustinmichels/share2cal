{
  "name": "share2cal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "bun test ./tests",
    "fmt": "oxfmt",
    "tauri": "tauri",
    "update": "bun update && cargo update --manifest-path src-tauri/Cargo.toml",
    "docs:dev": "bun run --cwd docs dev",
    "docs:build": "bun run --cwd docs build",
    "docs:preview": "bun run --cwd docs preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/language-server": "^3.3.14",
    "oxfmt": "^0.66.0",
    "typescript": "~6.0.3",
    "typescript-language-server": "^6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  }
}
