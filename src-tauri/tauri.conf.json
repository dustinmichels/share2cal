{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Share2Cal",
  "version": "0.1.0",
  "identifier": "com.dustinmichels.share2cal",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Share2Cal",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "frameworks": ["Vision.framework", "ImageIO.framework", "EventKit.framework"]
    },
    "macOS": {
      "frameworks": ["Vision", "ImageIO", "EventKit"]
    }
  }
}
